# Copy to .env (git-ignored). Never commit real values. `npm run setup` fills the generated keys.
NEAR_NETWORK=testnet
# From near/agent-skills near-api-js RPC table; any provider from docs.near.org/api/rpc/providers works.
NEAR_RPC=https://test.rpc.fastnear.com

# Your testnet account that deploys and owns the contract (full-access key: owner machine only, never in an agent).
OWNER_ACCOUNT=
OWNER_KEY=
# Contract account, e.g. pactum.<you>.testnet (create it as a sub-account of OWNER_ACCOUNT).
PACTUM_CONTRACT=
PACTUM_CONTRACT_KEY=
# Relayer that pays gas for agents' meta transactions (can be OWNER).
RELAYER_ACCOUNT=
RELAYER_KEY=

# Generated by `npm run setup`: function-call keys for enclave runtimes.
ATLAS_AGENT_KEY=
MERIDIAN_AGENT_KEY=
MALLORY_AGENT_KEY=
# Generated by `npm run setup`: secp256k1 seeds for simulated TEE judges.
SIM_JUDGE_SEEDS=

# Optional: NEAR AI Cloud key (cloud.near.ai or nearbuilders.org/dashboard). Enables real TEE judges.
NEAR_AI_API_KEY=
# Optional: 1-Click JWT (partners.near-intents.org). Without it quotes carry a 0.2% fee.
ONECLICK_JWT=
